{
  "name": "arpa-js",
  "version": "1.0.0",
  "description": "Arpa 2",
  "main": "arpa.js",
  "private": true,
  "scripts": {
    "copy-files": "scripts/copy-files.sh",
    "add-ktp-koe-update": "scripts/add-ktp-koe-update.sh",
    "server:compile": "npm run copy-files && npm run add-ktp-koe-update && tsc -p server",
    "server:watch": "npm run copy-files && npm run add-ktp-koe-update && tsc -p server -w --preserveWatchOutput",
    "compile": "npm run server:compile",
    "watch": "npm run server:watch & APP_ENV=development nodemon --config nodemon.json ./bin/arpajs & wait",
    "lint": "eslint bin/arpajs . --ext .js,.ts --quiet",
    "test": "tsc --noEmit && APP_ENV=unit-tests nyc --reporter text mocha",
    "create-migration": "create-migration",
    "db:migrate": "npm run server:compile && APP_ENV=development ./bin/run-migrations.js",
    "db:migrate-unittests": "npm run server:compile && APP_ENV=unit-tests ./bin/run-migrations.js",
    "s3:create-dev-buckets": "npm run server:compile && APP_ENV=development ./bin/create-dev-buckets.js",
    "dev:start": "npm run server:compile && APP_ENV=development ./bin/run-migrations.js && npm run watch",
    "start": "node --trace-uncaught ./bin/arpajs"
  },
  "author": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/client-secrets-manager": "^3.1169.0",
    "@aws-sdk/client-sqs": "^3.1169.0",
    "@aws-sdk/client-ssm": "^3.1169.0",
    "@aws-sdk/client-sts": "^3.1169.0",
    "@aws-sdk/lib-storage": "^3.1169.0",
    "@digabi/answer-utils": "^0.0.2",
    "@digabi/crypto-utils": "^1.0.5",
    "@digabi/database-utils": "^0.0.7",
    "@digabi/exam-engine-exams": "^25.2.2",
    "@digabi/exam-engine-generator": "^25.3.0",
    "@digabi/exam-engine-mastering": "^25.3.0",
    "@digabi/express-utils": "^0.4.0",
    "@digabi/fetch": "^2.1.2",
    "@digabi/json-exam-utils": "^0.1.0",
    "@digabi/logger": "^3.0.0",
    "@digabi/passphrase-generator": "^0.0.2",
    "@digabi/testing": "^0.0.6",
    "@digabi/validation": "^4.2.0",
    "@digabi/zip-utils": "^1.1.1",
    "@ffprobe-installer/ffprobe": "^2.0.0",
    "@smithy/node-http-handler": "^4.14.2",
    "bluebird": "^3.4.5",
    "body-parser": "^2.4.0",
    "commander": "^15.1.0",
    "date-fns": "^4.4.0",
    "express": "^5.3.0",
    "file-type": "^16.5.3",
    "helmet": "^8.3.0",
    "is-my-json-valid": "^2.10.1",
    "lodash": "^4.18.1",
    "mime": "^3.0.0",
    "multer": "^2.5.0",
    "music-metadata": "^7.0.2",
    "nodemailer": "^10.6.0",
    "partial.lenses": "^14.17.0",
    "partial.lenses.validation": "^2.0.0",
    "pg-using-bluebird": "^4.0.0",
    "promisify-child-process": "^5.0.1",
    "ramda": "^0.32.0",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5",
    "sql-template-strings": "^2.2.2",
    "traverse": "^0.6.14",
    "ts-node": "^10.8.0",
    "typescript": "^6.0.3",
    "uuid": "^14.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@digabi/eslint-config": "^4.0.1",
    "@digabi/typescript-config": "^3.0.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.4",
    "@types/chai": "^4.1.7",
    "@types/chai-as-promised": "^8.0.2",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.27",
    "@types/mocha": "^10.0.0",
    "@types/ramda": "^0.32.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/sinon-express-mock": "^1.3.8",
    "chai": "^4.1.2",
    "chai-as-promised": "^7.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-mocha": "^11.3.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-promise": "^7.3.0",
    "mocha": "^12.0.3",
    "mocha-ctrf-json-reporter": "^0.2.0",
    "nodemon": "^3.1.14",
    "nyc": "^18.0.0",
    "pg": "^8.23.1",
    "pg-query-stream": "^4.17.1",
    "pm2": "^7.1.2",
    "prettier": "^3.10.1",
    "sinon": "^22.1.0",
    "sinon-express-mock": "^2.2.1",
    "typescript-eslint": "^8.72.2"
  },
  "optionalDependencies": {
    "@digabi/build-utils": "^4.0.0",
    "@digabi/config-secrets": "^5.2.0"
  },
  "allowScripts": {
    "@ffprobe-installer/darwin-arm64@5.0.1": true,
    "fsevents@2.3.3": true,
    "libxmljs2@0.37.0": true,
    "unrs-resolver@1.12.2": true
  }
}
